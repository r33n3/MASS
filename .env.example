# MASS Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# Application Settings
# ============================================
MASS_APP_NAME=MASS
MASS_ENVIRONMENT=development  # development, staging, production
MASS_DEBUG=false
MASS_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# API Settings
# ============================================
MASS_API_HOST=0.0.0.0
MASS_API_PORT=8000
MASS_API_WORKERS=4
MASS_API_CORS_ORIGINS=["*"]
MASS_API_RATE_LIMIT=100  # Requests per minute

# ============================================
# Database Settings
# ============================================
# For PostgreSQL (production/full testing):
MASS_DB_URL=postgresql+asyncpg://mass:mass@postgres:5432/mass

# For SQLite (lightweight testing):
# MASS_DB_URL=sqlite+aiosqlite:///./data/mass.db

MASS_DB_POOL_SIZE=10
MASS_DB_MAX_OVERFLOW=20
MASS_DB_POOL_TIMEOUT=30
MASS_DB_ECHO=false  # Set to true to see SQL queries

# ============================================
# Redis Settings
# ============================================
MASS_REDIS_URL=redis://redis:6379/0
MASS_REDIS_MAX_CONNECTIONS=50
MASS_REDIS_SOCKET_TIMEOUT=5.0

# ============================================
# Authentication Settings
# ============================================
MASS_AUTH_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
MASS_AUTH_ALGORITHM=HS256
MASS_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
MASS_AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
MASS_AUTH_API_KEY_PREFIX=mass_
MASS_AUTH_API_KEY_SALT=mass-api-key-salt-change-in-production

# ============================================
# Storage Settings
# ============================================
MASS_STORAGE_PROVIDER=local  # local, s3, azure, gcs
MASS_STORAGE_LOCAL_PATH=./data/storage

# S3 Settings (if using s3)
# MASS_STORAGE_S3_BUCKET=my-mass-bucket
# MASS_STORAGE_S3_REGION=us-east-1
# MASS_STORAGE_S3_ACCESS_KEY=
# MASS_STORAGE_S3_SECRET_KEY=

# Azure Settings (if using azure)
# MASS_STORAGE_AZURE_CONTAINER=mass-storage
# MASS_STORAGE_AZURE_CONNECTION_STRING=

# GCS Settings (if using gcs)
# MASS_STORAGE_GCS_BUCKET=my-mass-bucket
# MASS_STORAGE_GCS_CREDENTIALS_FILE=/path/to/credentials.json

# ============================================
# Queue Settings
# ============================================
MASS_QUEUE_PROVIDER=redis  # memory, redis, sqs, servicebus, pubsub

# AWS SQS Settings (if using sqs)
# MASS_QUEUE_SQS_QUEUE_URL=
# MASS_QUEUE_SQS_REGION=us-east-1

# Azure Service Bus Settings (if using servicebus)
# MASS_QUEUE_SERVICEBUS_CONNECTION_STRING=
# MASS_QUEUE_SERVICEBUS_QUEUE_NAME=mass-jobs

# GCP Pub/Sub Settings (if using pubsub)
# MASS_QUEUE_PUBSUB_PROJECT_ID=
# MASS_QUEUE_PUBSUB_TOPIC_ID=mass-jobs
# MASS_QUEUE_PUBSUB_SUBSCRIPTION_ID=mass-jobs-sub

# ============================================
# Scanning Settings
# ============================================
MASS_SCAN_TIMEOUT_SECONDS=3600
MASS_SCAN_MAX_CONCURRENT=10
MASS_PROBE_BATCH_SIZE=50

# ============================================
# AI Model Provider API Keys
# ============================================
# OpenAI
MASS_OPENAI_API_KEY=

# Anthropic
MASS_ANTHROPIC_API_KEY=

# Google
MASS_GOOGLE_API_KEY=

# ============================================
# Docker-Specific Settings
# ============================================
# PostgreSQL (for docker-compose)
POSTGRES_USER=mass
POSTGRES_PASSWORD=mass
POSTGRES_DB=mass

# Redis (for docker-compose)
REDIS_PASSWORD=
